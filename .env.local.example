# Copy this file to .env.local and fill in real values for the project.
# Get projectId/dataset by running `npx sanity init` (creates a new
# Sanity project) or from sanity.io/manage if the project already exists.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# The live domain, for canonical URLs and the sitemap (no trailing slash).
# Leave empty until the domain is set up; the host's own URL is used then.
NEXT_PUBLIC_SITE_URL=

# Only needed if a page uses the Contact Form block. Without these, the
# form still works end-to-end but sends to a disposable test inbox
# (a preview link is logged to the server console) instead of real mail.
# EMAIL_PASS must be a Google Account "app password", not the normal
# account password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
# Where contact form submissions are delivered. Defaults to EMAIL_USER
# itself if left blank.
CONTACT_EMAIL=
